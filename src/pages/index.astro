---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Disclaimer from "../components/Disclaimer.astro";
import APergunta from "../components/APergunta.astro";
import Resultados from "../components/Resultados.astro";
import OndeFalha from "../components/OndeFalha.astro";
import Lexico from "../components/Lexico.astro";
import Escopo from "../components/Escopo.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import ComoRodar from "../components/ComoRodar.astro";
import Footer from "../components/Footer.astro";

const title = "raciocinio-br-mcp: raciocínio clínico brasileiro avaliado em LLM local";
const description =
  "Experimento de pesquisa, open source, sobre raciocínio clínico em contexto brasileiro rodando em LLM local: hipóteses com procedência e uma avaliação publicada junto com o código, incluindo onde falha. Um projeto IA.med. Não é apoio à decisão clínica.";
---

<Layout title={title} description={description}>
  <main>
    <Hero />
    <Disclaimer />
    <APergunta />
    <Resultados />
    <OndeFalha />
    <Lexico />
    <Escopo />
    <ComoFunciona />
    <ComoRodar />
  </main>
  <Footer />
</Layout>
