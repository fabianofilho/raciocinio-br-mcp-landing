---
const condicoes = [
  { nome: "Hipertensão Arterial Sistêmica", diretriz: "PCDT HAS", portaria: "Portaria SECTICS/MS nº 49, 2025", status: "vigente" },
  { nome: "Diabete Melito Tipo 2", diretriz: "PCDT DM2", portaria: "Portaria SCTIE/MS nº 13/2026", status: "em atualização" },
  { nome: "Asma", diretriz: "PCDT Asma", portaria: "Portaria Conjunta nº 43, 2026", status: "vigente" },
  { nome: "Dislipidemia", diretriz: "PCDT Dislipidemia", portaria: "Portaria Conjunta nº 8, 2019", status: "em atualização" },
  { nome: "Sobrepeso e Obesidade em Adultos", diretriz: "PCDT Sobrepeso e Obesidade", portaria: "Portaria SCTIE/MS nº 53, 2020", status: "vigente" },
  { nome: "Tabagismo", diretriz: "PCDT Tabagismo", portaria: "Portaria Conjunta nº 10, 2020", status: "vigente" },
];
---

<section id="escopo" class="border-b border-neutral-900">
  <div class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Escopo coberto</p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">
      Seis condições de medicina de família, e só
    </h2>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Cada uma com a diretriz de referência da Conitec. Fora deste escopo o
      sistema deve responder "fora do escopo": isso é decisão de design, não
      limitação temporária. O CID-10 principal fica pendente de decisão clínica.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        condicoes.map((c) => (
          <div class="flex flex-col rounded-xl border border-neutral-800 bg-ink-800 p-5">
            <h3 class="text-base font-semibold text-white">{c.nome}</h3>
            <p class="mt-2 text-xs text-neutral-400">{c.diretriz}</p>
            <p class="mt-1 text-xs text-neutral-500">{c.portaria}</p>
            <span class={`mt-3 w-fit rounded-full px-2 py-0.5 text-xs font-medium ${c.status === "vigente" ? "bg-emerald/10 text-emerald" : "bg-amber-500/10 text-amber-300"}`}>
              {c.status}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
