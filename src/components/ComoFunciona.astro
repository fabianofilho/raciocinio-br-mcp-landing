---
import CodeBlock from "./CodeBlock.astro";

const camadas = [
  { n: "01", titulo: "Léxico", texto: "Normaliza o vocabulário brasileiro do caso. Termo ambíguo é devolvido com as leituras, sem escolher." },
  { n: "02", titulo: "Recuperação", texto: "Busca full-text (DuckDB) na base de evidência dos PCDTs, com um piso de cobertura que decide se a pergunta está no escopo." },
  { n: "03", titulo: "LLM local", texto: "O modelo raciocina sobre os trechos recuperados, na sua máquina." },
  { n: "04", titulo: "Estruturação com procedência", texto: "Cada hipótese sai com citação literal, se a citação confere no documento, a confiança, e a lista do que ficou indeterminado." },
];

// Assinaturas e descrições conferidas contra mcp_server/server.py da v0.1.0.
const tools = [
  {
    nome: "raciocinar_caso",
    assinatura: "raciocinar_caso(descricao_caso: str)",
    desc: "Hipóteses com procedência, conduta, trechos-fonte, termos normalizados, indeterminados, condicao_no_escopo, modelo e um aviso que começa por \"NÃO REVISADO CLINICAMENTE\". Nenhum campo é opcional. Precisa do LLM local.",
  },
  {
    nome: "normalizar_termo",
    assinatura: "normalizar_termo(termo: str)",
    desc: "O que o léxico entende do termo. Ambíguo volta com as leituras, sem escolha. Léxico 0.1.0, 12 entradas, revisão pendente.",
  },
  {
    nome: "explicar_cobertura",
    assinatura: "explicar_cobertura(condicao: str = '')",
    desc: "O que a base cobre, para saber se a pergunta está no escopo antes de confiar na resposta. Aceita nome, sigla e sinônimo (\"DM2\", \"HAS\", \"fumo\"); vazio lista as seis condições.",
  },
];

// Saídas reais de explicar_cobertura("DM2") com o código da v0.1.0, sobre os
// PDFs baixados em 2026-09-20. A primeira depois de reindexar; a segunda numa
// base indexada pela extração antiga de CID-10.
const exemploCobertura = `{
  "consulta": "DM2",
  "no_escopo": true,
  "total_condicoes": 1,
  "condicoes": [
    {
      "condicao": "Diabete Melito Tipo 2",
      "slug": "diabete-melito-tipo-2",
      "cid10": "PENDENTE",
      "cids_no_texto": ["E11", "E11.2", "E11.3", "E11.4", "E11.5",
                        "E11.6", "E11.7", "E11.8", "E11.9"],
      "documento": "PCDT Diabete Melito Tipo 2",
      "portaria": "Portaria SCTIE/MS nº 13/2026 - 21/02/2026",
      "data_documento": "2026-02-21",
      "url": "https://www.gov.br/conitec/pt-br/midias/protocolos/2026/pcdt-diabete-melito-tipo-2/@@display-file/file",
      "status_conitec": "em atualização",
      "trechos_indexados": 208,
      "coletado_em": "2026-09-20 21:19:43.053156"
    }
  ],
  "aviso": "'DM2' casou com Diabete Melito Tipo 2 por sinônimo ou pelo léxico, não pelo nome da condição. Confira se é a condição que você procura: o escopo cobre só o que está listado aqui.",
  "revisao_clinica": "NÃO REVISADO CLINICAMENTE: gabaritos de avaliação, léxico e CID-10 deste experimento ainda não passaram por revisão clínica."
}`;

const exemploBaseAntiga = `"cids_no_texto": [],
"aviso": "'DM2' casou com Diabete Melito Tipo 2 por sinônimo ou pelo léxico, não pelo nome da condição. Confira se é a condição que você procura: o escopo cobre só o que está listado aqui. A base foi indexada por uma versão antiga da extração de CID-10, que pegava códigos de tabelas e referências; os candidatos de Diabete Melito Tipo 2 foram omitidos. Rode 'raciocinio-cli coletar' para reindexar."`;
---

<section id="como-funciona" class="border-b border-neutral-900">
  <div class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald">Como funciona</p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">
      Do texto livre à hipótese com procedência
    </h2>

    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        camadas.map((c, i) => (
          <li class="relative rounded-xl border border-neutral-800 bg-ink-800 p-5">
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm font-bold text-emerald">{c.n}</span>
              <span class="hidden text-neutral-700 lg:inline-block" aria-hidden="true">{i < 3 ? "→" : ""}</span>
            </div>
            <h3 class="mt-3 text-base font-semibold text-white">{c.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-400">{c.texto}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 flex gap-3 rounded-xl border border-emerald/25 bg-emerald/5 p-4">
      <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4z" />
      </svg>
      <p class="text-sm leading-relaxed text-neutral-300">
        Uma resposta confiante sem procedência é tratada como <strong class="font-semibold text-white">bug</strong>,
        não como estilo: o modelo de saída recusa hipótese com confiança acima de
        0,5 sem trecho-fonte, e o pipeline rebaixa a confiança do que for afirmado
        sem origem, registrando o rebaixamento em <span class="font-mono">indeterminados</span>.
      </p>
    </div>

    <h3 class="mt-12 text-base font-semibold text-white">As três tools</h3>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        tools.map((t) => (
          <div class="rounded-xl border border-neutral-800 bg-ink-800 p-4">
            <p class="break-words font-mono text-xs font-semibold text-emerald">{t.assinatura}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-neutral-400">{t.desc}</p>
          </div>
        ))
      }
    </div>

    <h3 class="mt-10 text-base font-semibold text-white">Exemplo: <span class="font-mono text-emerald">explicar_cobertura("DM2")</span></h3>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-neutral-400">
      <span class="font-mono text-neutral-300">coletado_em</span> é a data em que o PDF
      foi baixado da Conitec, não a da última reindexação.
      <span class="font-mono text-neutral-300">cids_no_texto</span> são candidatos
      extraídos da seção de classificação CID-10 do próprio PCDT; o CID principal
      continua <span class="font-mono text-neutral-300">PENDENTE</span> de decisão clínica.
    </p>
    <div class="mt-4">
      <CodeBlock code={exemploCobertura} lang="json" caption="Saída real do código da v0.1.0, depois de reindexar." />
    </div>
    <p class="mt-6 max-w-2xl text-sm leading-relaxed text-neutral-400">
      Numa base indexada antes da v0.1.0, os candidatos antigos (que traziam códigos
      de tabelas e referências) não vazam: <span class="font-mono text-neutral-300">cids_no_texto</span>
      volta vazio e o aviso de reindexação se soma ao de sinônimo.
    </p>
    <div class="mt-4">
      <CodeBlock code={exemploBaseAntiga} lang="json" caption="Mesma consulta, base indexada pela extração antiga." />
    </div>
  </div>
</section>
