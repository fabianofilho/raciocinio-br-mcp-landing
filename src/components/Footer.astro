---
import { IAMED_URL, LICENSE, PROJECT, FAMILY, SELF_SLUG } from "../consts";
const ano = new Date().getFullYear();
const outros = FAMILY.filter((m) => m.slug !== SELF_SLUG);
---

<footer class="mx-auto max-w-4xl px-6 py-12">
  <!-- Familia de MCPs -->
  <div class="rounded-2xl border border-neutral-800 bg-ink-800 p-6">
    <p class="text-sm font-semibold text-white">Família de MCPs da IA.med</p>
    <p class="mt-1 text-sm text-neutral-500">Outros servidores da mesma linha.</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        outros.map((m) => (
          <li>
            <a
              href={m.url}
              class="group flex items-center justify-between rounded-xl border border-neutral-800 bg-ink-900 px-4 py-3 transition-colors hover:border-emerald"
            >
              <span>
                <span class="block font-mono text-sm font-semibold text-neutral-200 group-hover:text-emerald">{m.nome}</span>
                <span class="block text-xs text-neutral-500">{m.desc}</span>
              </span>
              <svg class="h-4 w-4 flex-shrink-0 text-neutral-600 group-hover:text-emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-mono text-sm font-semibold text-white">{PROJECT}</p>
      <p class="mt-1 text-sm text-neutral-500">
        Um projeto <a href={IAMED_URL} class="text-emerald hover:underline">IA.med</a>. Licença {LICENSE}. Repositório privado nesta versão.
      </p>
    </div>

    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm" aria-label="Rodapé">
      <a href={IAMED_URL} class="text-neutral-400 transition-colors hover:text-emerald">iamed.cc</a>
    </nav>
  </div>

  <p class="mt-8 border-t border-neutral-900 pt-6 text-xs text-neutral-600">
    &copy; {ano} IA.med. Experimento de pesquisa, não revisado clinicamente, não é apoio à decisão clínica
    nem dispositivo médico. Consulte sempre a fonte oficial e o julgamento clínico.</p>
</footer>
